algoritmo "VerificadorAcesso"
var
   logins: vetor[1..100] de caractere
      senhas: vetor[1..100] de caractere
         total, opcao, i, pos: inteiro
            loginDigitado, senhaDigitada: caractere
            inicio
               total <- 0

                  repita
                        escreval("===== MENU =====")
                              escreval("1 - Cadastrar usuário")
                                    escreval("2 - Listar usuários")
                                          escreval("3 - Login no sistema")
                                                escreval("4 - Excluir usuário")
                                                      escreval("0 - Sair")
                                                            escreva("Escolha uma opção: ")
                                                                  leia(opcao)

                                                                        escolha opcao
                                                                                 caso 1
                                                                                             total <- total + 1
                                                                                                         escreva("Digite o login: ")
                                                                                                                     leia(logins[total])
                                                                                                                                 escreva("Digite a senha: ")
                                                                                                                                             leia(senhas[total])
                                                                                                                                                         escreval("Usuário cadastrado com sucesso!")

                                                                                                                                                                  caso 2
                                                                                                                                                                              se total = 0 entao
                                                                                                                                                                                             escreval("Nenhum usuário cadastrado.")
                                                                                                                                                                                                         senao
                                                                                                                                                                                                                        escreval("=== Lista de Usuários ===")
                                                                                                                                                                                                                                       para i de 1 ate total faca
                                                                                                                                                                                                                                                         escreval(i, " - Login: ", logins[i])
                                                                                                                                                                                                                                                                        fimpara
                                                                                                                                                                                                                                                                                    fimse

                                                                                                                                                                                                                                                                                             caso 3
                                                                                                                                                                                                                                                                                                         escreva("Digite o login: ")
                                                                                                                                                                                                                                                                                                                     leia(loginDigitado)
                                                                                                                                                                                                                                                                                                                                 escreva("Digite a senha: ")
                                                                                                                                                                                                                                                                                                                                             leia(senhaDigitada)

                                                                                                                                                                                                                                                                                                                                                         pos <- 0
                                                                                                                                                                                                                                                                                                                                                                     para i de 1 ate total faca
                                                                                                                                                                                                                                                                                                                                                                                    se logins[i] = loginDigitado e senhas[i] = senhaDigitada entao
                                                                                                                                                                                                                                                                                                                                                                                                      pos <- i
                                                                                                                                                                                                                                                                                                                                                                                                                     fimse
                                                                                                                                                                                                                                                                                                                                                                                                                                 fimpara

                                                                                                                                                                                                                                                                                                                                                                                                                                             se pos > 0 entao
                                                                                                                                                                                                                                                                                                                                                                                                                                                            escreval("Acesso permitido! Bem-vindo, ", logins[pos])
                                                                                                                                                                                                                                                                                                                                                                                                                                                                        senao
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       escreval("Login ou senha inválidos.")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   fimse

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            caso 4
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        escreva("Digite o número do usuário para excluir: ")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    leia(pos)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                se pos >= 1 e pos <= total entao
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               para i de pos ate total-1 faca
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 logins[i] <- logins[i+1]
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   senhas[i] <- senhas[i+1]
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  fimpara
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 total <- total - 1
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                escreval("Usuário excluído com sucesso!")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            senao
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           escreval("Usuário inválido.")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       fimse
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             fimescolha
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                ate opcao = 0

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   escreval("Sistema encerrado.")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   fimalgoritmo
