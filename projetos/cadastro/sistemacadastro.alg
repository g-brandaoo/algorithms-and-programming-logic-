algoritmo "CadastroSimples"
var
   nomes: vetor[1..100] de caractere
      idades: vetor[1..100] de inteiro
         total, opcao, i, pos: inteiro
         inicio
            total <- 0

               repita
                     escreval("===== MENU =====")
                           escreval("1 - Cadastrar usuário")
                                 escreval("2 - Listar usuários")
                                       escreval("3 - Editar usuário")
                                             escreval("4 - Excluir usuário")
                                                   escreval("0 - Sair")
                                                         escreva("Escolha uma opção: ")
                                                               leia(opcao)

                                                                     escolha opcao
                                                                              caso 1
                                                                                          total <- total + 1
                                                                                                      escreva("Digite o nome: ")
                                                                                                                  leia(nomes[total])
                                                                                                                              escreva("Digite a idade: ")
                                                                                                                                          leia(idades[total])
                                                                                                                                                      escreval("Usuário cadastrado com sucesso!")

                                                                                                                                                               caso 2
                                                                                                                                                                           se total = 0 entao
                                                                                                                                                                                          escreval("Nenhum usuário cadastrado.")
                                                                                                                                                                                                      senao
                                                                                                                                                                                                                     escreval("=== Lista de Usuários ===")
                                                                                                                                                                                                                                    para i de 1 ate total faca
                                                                                                                                                                                                                                                      escreval(i, " - Nome: ", nomes[i], " | Idade: ", idades[i])
                                                                                                                                                                                                                                                                     fimpara
                                                                                                                                                                                                                                                                                 fimse

                                                                                                                                                                                                                                                                                          caso 3
                                                                                                                                                                                                                                                                                                      escreva("Digite o número do usuário para editar: ")
                                                                                                                                                                                                                                                                                                                  leia(pos)
                                                                                                                                                                                                                                                                                                                              se pos >= 1 e pos <= total entao
                                                                                                                                                                                                                                                                                                                                             escreva("Novo nome: ")
                                                                                                                                                                                                                                                                                                                                                            leia(nomes[pos])
                                                                                                                                                                                                                                                                                                                                                                           escreva("Nova idade: ")
                                                                                                                                                                                                                                                                                                                                                                                          leia(idades[pos])
                                                                                                                                                                                                                                                                                                                                                                                                         escreval("Usuário atualizado com sucesso!")
                                                                                                                                                                                                                                                                                                                                                                                                                     senao
                                                                                                                                                                                                                                                                                                                                                                                                                                    escreval("Usuário inválido.")
                                                                                                                                                                                                                                                                                                                                                                                                                                                fimse

                                                                                                                                                                                                                                                                                                                                                                                                                                                         caso 4
                                                                                                                                                                                                                                                                                                                                                                                                                                                                     escreva("Digite o número do usuário para excluir: ")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 leia(pos)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             se pos >= 1 e pos <= total entao
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            para i de pos ate total-1 faca
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              nomes[i] <- nomes[i+1]
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                idades[i] <- idades[i+1]
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               fimpara
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              total <- total - 1
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             escreval("Usuário excluído com sucesso!")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         senao
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        escreval("Usuário inválido.")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    fimse
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          fimescolha
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             ate opcao = 0

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                escreval("Programa encerrado.")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                fimalgoritmo
