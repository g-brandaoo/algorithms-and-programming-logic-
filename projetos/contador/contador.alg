algoritmo "ContadorSimples"
var
   numero: inteiro

   inicio
      escreval("=== Sistema de Contador Simples ===")
         escreva("Digite até qual número deseja contar: ")
            leia(numero)

               escreval("Contagem:")

                  enquanto numero > 0 faca
                        escreval(numero)
                              numero <- numero - 1
                                 fimenquanto

                                    escreval("Fim da contagem!")
                                    fimalgoritmo
