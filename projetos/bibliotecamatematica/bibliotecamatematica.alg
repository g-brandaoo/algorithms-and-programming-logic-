algoritmo "BibliotecaMatematica"
var
   a, b: real

   inicio
      escreval("=== Biblioteca Matemática ===")
         escreva("Digite o primeiro número: ")
            leia(a)

               escreva("Digite o segundo número: ")
                  leia(b)

                     escreval("Soma: ", a + b)
                        escreval("Subtração: ", a - b)
                           escreval("Multiplicação: ", a * b)
                              escreval("Divisão: ", a / b)
                              fimalgoritmo
