algoritmo "MediaEscolar"
var
   nomes: vetor[1..100] de caractere
      notas1: vetor[1..100] de real
         notas2: vetor[1..100] de real
            medias: vetor[1..100] de real
               total, opcao, i, pos: inteiro
               inicio
                  total <- 0

                     repita
                           escreval("===== MENU =====")
                                 escreval("1 - Cadastrar aluno")
                                       escreval("2 - Listar alunos e médias")
                                             escreval("3 - Editar notas")
                                                   escreval("4 - Excluir aluno")
                                                         escreval("0 - Sair")
                                                               escreva("Escolha uma opção: ")
                                                                     leia(opcao)

                                                                           escolha opcao
                                                                                    caso 1
                                                                                                total <- total + 1
                                                                                                            escreva("Digite o nome do aluno: ")
                                                                                                                        leia(nomes[total])
                                                                                                                                    escreva("Digite a primeira nota: ")
                                                                                                                                                leia(notas1[total])
                                                                                                                                                            escreva("Digite a segunda nota: ")
                                                                                                                                                                        leia(notas2[total])
                                                                                                                                                                                    medias[total] <- (notas1[total] + notas2[total]) / 2
                                                                                                                                                                                                escreval("Aluno cadastrado com sucesso!")

                                                                                                                                                                                                         caso 2
                                                                                                                                                                                                                     se total = 0 entao
                                                                                                                                                                                                                                    escreval("Nenhum aluno cadastrado.")
                                                                                                                                                                                                                                                senao
                                                                                                                                                                                                                                                               escreval("=== Lista de Alunos ===")
                                                                                                                                                                                                                                                                              para i de 1 ate total faca
                                                                                                                                                                                                                                                                                                escreval(i, " - Nome: ", nomes[i], 
                                                                                                                                                                                                                                                                                                                           " | Nota1: ", notas1[i], 
                                                                                                                                                                                                                                                                                                                                                      " | Nota2: ", notas2[i], 
                                                                                                                                                                                                                                                                                                                                                                                 " | Média: ", medias[i])
                                                                                                                                                                                                                                                                                                                                                                                                fimpara
                                                                                                                                                                                                                                                                                                                                                                                                            fimse

                                                                                                                                                                                                                                                                                                                                                                                                                     caso 3
                                                                                                                                                                                                                                                                                                                                                                                                                                 escreva("Digite o número do aluno para editar: ")
                                                                                                                                                                                                                                                                                                                                                                                                                                             leia(pos)
                                                                                                                                                                                                                                                                                                                                                                                                                                                         se pos >= 1 e pos <= total entao
                                                                                                                                                                                                                                                                                                                                                                                                                                                                        escreva("Nova nota 1: ")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       leia(notas1[pos])
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      escreva("Nova nota 2: ")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     leia(notas2[pos])
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    medias[pos] <- (notas1[pos] + notas2[pos]) / 2
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   escreval("Notas atualizadas com sucesso!")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               senao
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              escreval("Aluno inválido.")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          fimse

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   caso 4
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               escreva("Digite o número do aluno para excluir: ")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           leia(pos)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       se pos >= 1 e pos <= total entao
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      para i de pos ate total-1 faca
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        nomes[i] <- nomes[i+1]
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          notas1[i] <- notas1[i+1]
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            notas2[i] <- notas2[i+1]
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              medias[i] <- medias[i+1]
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             fimpara
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            total <- total - 1
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           escreval("Aluno excluído com sucesso!")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       senao
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      escreval("Aluno inválido.")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  fimse
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        fimescolha
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           ate opcao = 0

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              escreval("Programa encerrado.")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              fimalgoritmo
