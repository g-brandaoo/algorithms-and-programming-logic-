algoritmo "CadastroSalario"
var
   nomes: vetor[1..100] de caractere
      salarios: vetor[1..100] de real
         total, opcao, i, pos: inteiro
         inicio
            total <- 0

               repita
                     escreval("===== MENU =====")
                           escreval("1 - Cadastrar funcionário")
                                 escreval("2 - Listar funcionários e salários")
                                       escreval("3 - Editar salário")
                                             escreval("4 - Excluir funcionário")
                                                   escreval("0 - Sair")
                                                         escreva("Escolha uma opção: ")
                                                               leia(opcao)

                                                                     escolha opcao
                                                                              caso 1
                                                                                          total <- total + 1
                                                                                                      escreva("Digite o nome do funcionário: ")
                                                                                                                  leia(nomes[total])
                                                                                                                              escreva("Digite o salário: ")
                                                                                                                                          leia(salarios[total])
                                                                                                                                                      escreval("Funcionário cadastrado com sucesso!")

                                                                                                                                                               caso 2
                                                                                                                                                                           se total = 0 entao
                                                                                                                                                                                          escreval("Nenhum funcionário cadastrado.")
                                                                                                                                                                                                      senao
                                                                                                                                                                                                                     escreval("=== Lista de Funcionários ===")
                                                                                                                                                                                                                                    para i de 1 ate total faca
                                                                                                                                                                                                                                                      escreval(i, " - Nome: ", nomes[i], " | Salário: R$ ", salarios[i])
                                                                                                                                                                                                                                                                     fimpara
                                                                                                                                                                                                                                                                                 fimse

                                                                                                                                                                                                                                                                                          caso 3
                                                                                                                                                                                                                                                                                                      escreva("Digite o número do funcionário para editar: ")
                                                                                                                                                                                                                                                                                                                  leia(pos)
                                                                                                                                                                                                                                                                                                                              se pos >= 1 e pos <= total entao
                                                                                                                                                                                                                                                                                                                                             escreva("Novo salário: ")
                                                                                                                                                                                                                                                                                                                                                            leia(salarios[pos])
                                                                                                                                                                                                                                                                                                                                                                           escreval("Salário atualizado com sucesso!")
                                                                                                                                                                                                                                                                                                                                                                                       senao
                                                                                                                                                                                                                                                                                                                                                                                                      escreval("Funcionário inválido.")
                                                                                                                                                                                                                                                                                                                                                                                                                  fimse

                                                                                                                                                                                                                                                                                                                                                                                                                           caso 4
                                                                                                                                                                                                                                                                                                                                                                                                                                       escreva("Digite o número do funcionário para excluir: ")
                                                                                                                                                                                                                                                                                                                                                                                                                                                   leia(pos)
                                                                                                                                                                                                                                                                                                                                                                                                                                                               se pos >= 1 e pos <= total entao
                                                                                                                                                                                                                                                                                                                                                                                                                                                                              para i de pos ate total-1 faca
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                nomes[i] <- nomes[i+1]
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  salarios[i] <- salarios[i+1]
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 fimpara
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                total <- total - 1
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               escreval("Funcionário excluído com sucesso!")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           senao
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          escreval("Funcionário inválido.")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      fimse
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            fimescolha
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               ate opcao = 0

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  escreval("Programa encerrado.")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  fimalgoritmo
